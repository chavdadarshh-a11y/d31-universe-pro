# ── Frontend (safe to expose; baked into the build) ─────────────────────────
# Leave Supabase empty to run in DEMO mode (everything stored on the device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google sign-in (One Tap) — OAuth "Web application" client id from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=
# Google API key (Drive API only, restricted to your site's HTTP referrers). Enables direct in-app streaming
# of Knowledge videos (speed / ±10 s controls) and in-app saves of videos & PDFs. Without it the player shows
# Drive's own preview inside the app and video/PDF saving shows "at launch".
VITE_GOOGLE_API_KEY=

# Shown on the Contact / Refund pages (Razorpay requires a visible contact)
VITE_SUPPORT_EMAIL=
VITE_BUSINESS_NAME=D31.UNIVERSE by Darshan Chavda

# Social links (hidden in the app when empty)
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_SNAPCHAT=
VITE_SOCIAL_FACEBOOK=

# ── Server secrets — NEVER put these in a VITE_ variable ────────────────────
# Set them with:  supabase secrets set NAME=value
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# ALLOWED_ORIGIN=https://your-domain.com
